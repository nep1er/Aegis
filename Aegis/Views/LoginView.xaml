<UserControl x:Class="Aegis.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Border Background="#2C3E50" 
                CornerRadius="10" 
                Padding="40" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="400">

            <StackPanel>
                <!-- Логотип -->
                <TextBlock Text="AEGIS" 
                           FontSize="42" 
                           FontWeight="Bold" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Система управления парковками" 
                           FontSize="14" 
                           Foreground="#BDC3C7"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- Поле логина -->
                <TextBlock Text="Логин" 
                           Foreground="White" 
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         Padding="10"
                         FontSize="14"
                         Background="#34495E"
                         Foreground="White"
                         BorderThickness="0"/>

                <!-- Поле пароля -->
                <TextBlock Text="Пароль" 
                           Foreground="White" 
                           Margin="0,20,0,5"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             Padding="10"
                             FontSize="14"
                             Background="#34495E"
                             Foreground="White"
                             BorderThickness="0"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <!-- Ошибка -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#E74C3C" 
                           Margin="0,15,0,0"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibilityConverter}}"
                           TextWrapping="Wrap"/>

                <!-- Кнопка входа -->
                <Button Content="Войти" 
                        Height="45"
                        Margin="0,30,0,0"
                        Background="#3498DB"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding LoginCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
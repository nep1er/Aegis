<UserControl x:Class="Aegis.Views.ReceptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                       Text="Оформление приемки автомобиля"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,30"/>

            <!-- Информация -->
            <Border Grid.Row="1" Background="#ECF0F1" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,10">
                        <TextBlock Text="Парковка:" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding ParkingAddress}" FontSize="16"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="20,0,0,10">
                        <TextBlock Text="Оператор:" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding OperatorName}" FontSize="16"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,10">
                        <TextBlock Text="Дата и время:" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding AdmissionDateText}" FontSize="16"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,0,0,10">
                        <TextBlock Text="Тариф:" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding CurrentTariff, StringFormat={}{0} ₽/час}" FontSize="16" Foreground="#27AE60"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Гос номер -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Государственный номер *" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         FontSize="16"
                         Padding="10"
                         Background="White"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,0,0,20">
                <TextBlock Text="Фотографии автомобиля" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding Photos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1" 
                        CornerRadius="5" Margin="5" Padding="5" Width="150">
                                <StackPanel>
                                    <Image Source="{Binding PreviewImage}" Height="100" Stretch="UniformToFill"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <Button Content="✕ Удалить" Height="25" Margin="0,5,0,0"
                                Background="#E74C3C" Foreground="White" BorderThickness="0"
                                Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="📷 Добавить фото" Height="40" Width="200" HorizontalAlignment="Left"
            Background="#3498DB" Foreground="White" BorderThickness="0"
            Command="{Binding AddPhotoCommand}"/>
            </StackPanel>

            <!-- Тип авто -->
            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <TextBlock Text="Тип автомобиля *" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding VehicleTypes}"
                          SelectedItem="{Binding SelectedVehicleType}"
                          DisplayMemberPath="Name"
                          Height="40"
                          FontSize="16"
                          Background="White"/>
            </StackPanel>

            <!-- Свободные места -->
            <StackPanel Grid.Row="4" Margin="0,0,0,20">
                <TextBlock Text="Свободные места *" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <DataGrid ItemsSource="{Binding FreeSpots}"
                          SelectedItem="{Binding SelectedSpot}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          Height="150"
                          Background="White"
                          BorderBrush="#BDC3C7"
                          BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ Места" Binding="{Binding Number}" Width="100"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding VehicleType}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Content="Отмена"
                        Width="150"
                        Height="45"
                        Margin="0,0,10,0"
                        Background="#95A5A6"
                        Foreground="White"
                        FontSize="16"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}"/>

                <Button Content="Принять автомобиль"
                        Width="250"
                        Height="45"
                        Background="#27AE60"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding SaveReceptionCommand}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
<UserControl x:Class="Aegis.Views.ReleaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                       Text="Выдача автомобиля"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Информация -->
            <Border Grid.Row="1" Background="#ECF0F1" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,10">
                        <TextBlock Text="Парковка:" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding ParkingAddress}" FontSize="16"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="20,0,0,10">
                        <TextBlock Text="Оператор:" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding OperatorName}" FontSize="16"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,10">
                        <TextBlock Text="Дата и время выдачи:" FontWeight="Bold" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding ReleaseDateText}" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Выбор авто -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="Автомобиль на стоянке *" 
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ActiveVehicles}"
                          SelectedItem="{Binding SelectedVehicle}"
                          Height="40" FontSize="14">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LicensePlate}" FontWeight="Bold"/>
                                <TextBlock Text=" — " Margin="5,0"/>
                                <TextBlock Text="{Binding VehicleType}"/>
                                <TextBlock Text=" | Место: " Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding SpotNumber}" FontWeight="Bold"/>
                                <TextBlock Text=" | С " Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding AdmissionDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Расчёты -->
            <Border Grid.Row="3" Background="#FFF3CD" Padding="20" CornerRadius="5" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Часов на стоянке" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding HoursParked, StringFormat={}{0} ч.}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="За стоянку" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding StorageFee, StringFormat={}{0} ₽}" FontSize="20" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Штраф эвакуации" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding TowFine, StringFormat={}{0} ₽}" FontSize="20" FontWeight="Bold" Foreground="#E67E22"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="ИТОГО" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0} ₽}" FontSize="24" FontWeight="Bold" Foreground="#C0392B"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Данные владельца и авто -->
            <Grid Grid.Row="4" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Данные владельца" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="ФИО владельца *" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding OwnerFullName, UpdateSourceTrigger=PropertyChanged}"
                             Height="35" Margin="0,0,0,10" Padding="8"/>

                    <TextBlock Text="VIN номер" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}"
                             Height="35" Margin="0,0,0,10" Padding="8"
                             ToolTip="17 символов (латинские буквы и цифры)"/>

                    <TextBlock Text="Марка" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}"
                             Height="35" Margin="0,0,0,10" Padding="8"/>

                    <TextBlock Text="Модель" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                             Height="35" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Документ" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Тип документа *" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding DocumentTypes}"
                              SelectedItem="{Binding SelectedDocumentType}"
                              DisplayMemberPath="Type"
                              Height="35" Margin="0,0,0,10"/>

                    <!-- Подсказка формата -->
                    <TextBlock Text="{Binding DocumentFormatHint}" 
                               Foreground="#7F8C8D" 
                               FontSize="12" 
                               Margin="0,0,0,5"
                               FontStyle="Italic"/>

                    <TextBlock Text="Номер документа *" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="35" Padding="8"
                             ToolTip="{Binding DocumentFormatHint}"/>
                </StackPanel>
            </Grid>

            <!-- Кнопки -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена"
                        Width="150" Height="45" Margin="0,0,10,0"
                        Background="#95A5A6" Foreground="White"
                        FontSize="16" BorderThickness="0" Cursor="Hand"
                        Command="{Binding CancelCommand}"/>

                <Button Content="💳 Перейти к оплате"
                        Width="250" Height="45"
                        Background="#27AE60" Foreground="White"
                        FontSize="16" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding ProceedToPaymentCommand}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
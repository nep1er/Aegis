<UserControl x:Class="Aegis.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Учётные записи" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="➕ Создать"
                    Width="150" Height="40" Margin="0,0,10,0"
                    Background="#27AE60" Foreground="White"
                    FontSize="16" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Command="{Binding CreateUserCommand}"/>

            <Button Grid.Column="2" Content="✏️ Редактировать"
                    Width="150" Height="40"
                    Background="#3498DB" Foreground="White"
                    FontSize="16" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Command="{Binding EditUserCommand}"/>
        </Grid>

        <!-- Контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Список пользователей -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Users}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1" 
                                    CornerRadius="5" Margin="0,0,0,10" Padding="15" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8F9F9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Login}" FontSize="14" Foreground="#7F8C8D"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#34495E" CornerRadius="5" Padding="10,5">
                                        <TextBlock Text="{Binding RoleName}" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Детали -->
            <Border Grid.Column="1" Width="400" Background="#F8F9F9" BorderBrush="#34495E" BorderThickness="2"
                    CornerRadius="10" Padding="25"
                    Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Подробности" FontSize="20" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="✕"
                                Width="35" Height="35"
                                Background="#E74C3C" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Command="{Binding HideDetailsCommand}"/>
                    </Grid>

                    <TextBlock Text="ФИО:" FontWeight="Bold" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding SelectedUserDetails.FullName}" FontSize="16" Margin="0,5,0,15"/>

                    <TextBlock Text="Логин:" FontWeight="Bold" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding SelectedUserDetails.Login}" FontSize="16" Margin="0,5,0,15"/>

                    <TextBlock Text="Телефон:" FontWeight="Bold" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding SelectedUserDetails.PhoneNumber, TargetNullValue='Не указан'}" FontSize="16" Margin="0,5,0,15"/>

                    <TextBlock Text="Роль:" FontWeight="Bold" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding SelectedUserDetails.RoleName}" FontSize="16" Margin="0,5,0,15"/>

                    <TextBlock Text="Парковки:" FontWeight="Bold" Foreground="#7F8C8D"/>
                    <ItemsControl ItemsSource="{Binding SelectedUserDetails.ParkingAddresses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="🗑️ Удалить пользователя"
                            Height="40" Margin="0,20,0,0"
                            Background="#E74C3C" Foreground="White"
                            FontSize="14" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand"
                            Command="{Binding DeleteUserCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
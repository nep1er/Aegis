<Window x:Class="Aegis.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" 
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#ECF0F1">
        <Border Background="White" Margin="30" Padding="30" CornerRadius="10">
            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="🔐 Смена пароля" 
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <!-- Старый пароль -->
                <TextBlock Text="Старый пароль" 
                           FontWeight="Bold" Foreground="#7F8C8D"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtOldPassword" 
                             Height="40" Padding="10"
                             FontSize="14"
                             Margin="0,0,0,15"/>

                <!-- Новый пароль -->
                <TextBlock Text="Новый пароль" 
                           FontWeight="Bold" Foreground="#7F8C8D"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtNewPassword" 
                             Height="40" Padding="10"
                             FontSize="14"
                             Margin="0,0,0,15"/>

                <!-- Подтверждение -->
                <TextBlock Text="Подтвердите новый пароль" 
                           FontWeight="Bold" Foreground="#7F8C8D"
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtConfirmPassword" 
                             Height="40" Padding="10"
                             FontSize="14"
                             Margin="0,0,0,20"/>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Width="120" Height="40" Margin="0,0,10,0"
                            Background="#95A5A6" Foreground="White"
                            FontSize="14" BorderThickness="0" Cursor="Hand"
                            Click="Cancel_Click"/>

                    <Button Content="Сохранить"
                            Width="150" Height="40"
                            Background="#3498DB" Foreground="White"
                            FontSize="14" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand"
                            Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
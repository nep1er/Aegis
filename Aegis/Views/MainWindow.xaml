<Window x:Class="Aegis.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aegis.ViewModels"
        xmlns:v="clr-namespace:Aegis.Views"
        Title="AEGIS - Система управления парковками" 
        Height="800" Width="1200"
        WindowState="Maximized">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReceptionViewModel}">
            <v:ReceptionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReleaseViewModel}">
            <v:ReleaseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <v:HistoryView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель навигации -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel>
                <TextBlock Text="AEGIS" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,50"/>

                <Button Content="Главная" 
                        Height="50"
                        Margin="10,5"
                        Background="#34495E"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding NavigateToDashboardCommand}"/>

                <Button Content="Оформление" 
                        Height="50"
                        Margin="10,5"
                        Background="#34495E"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding NavigateToReceptionCommand}"/>

                <Button Content="Выдача" 
                        Height="50"
                        Margin="10,5"
                        Background="#34495E"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding NavigateToReleaseCommand}"/>

                <Button Content="История авто" 
                        Height="50"
                        Margin="10,5"
                        Background="#34495E"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding NavigateToHistoryCommand}"/>
            </StackPanel>
        </Border>

        <!-- Основной контент -->
        <Border Grid.Column="1" Background="#ECF0F1">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>
<Window x:Class="Aegis.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aegis.ViewModels"
        xmlns:v="clr-namespace:Aegis.Views"
        xmlns:converters="clr-namespace:Aegis.Converters"
        Title="AEGIS - Система управления парковками" 
        Height="800" Width="1200"
        WindowState="Maximized">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- DataTemplates для ViewModel'ей -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReceptionViewModel}">
            <v:ReceptionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReleaseViewModel}">
            <v:ReleaseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <v:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <v:LoginView />
        </DataTemplate>

        <!-- DataTemplates для админа -->
        <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}">
            <v:AdminDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <v:EmployeesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ParkingEditorViewModel}">
            <v:ParkingEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <v:AnalyticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminHistoryViewModel}">
            <v:AdminHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentsHistoryViewModel}">
            <v:PaymentsHistoryView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="93*"/>
        </Grid.ColumnDefinitions>
        <!-- Основной layout (показывается только после входа) -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibilityConverter}}" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Левая панель навигации для ОПЕРАТОРА -->
            <Border Grid.Column="0" Grid.Row="0" Background="#2C3E50"
                    Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="AEGIS" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,50"/>

                    <Button Content="Главная" 
                            Height="50"
                            Margin="10,5"
                            Background="#34495E"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding NavigateToDashboardCommand}"/>


                    <Button Content="Выдача" 
                            Height="50"
                            Margin="10,5"
                            Background="#34495E"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding NavigateToReleaseCommand}"/>

                    <Button Content="История авто" 
                            Height="50"
                            Margin="10,5"
                            Background="#34495E"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding NavigateToHistoryCommand}"/>
                </StackPanel>
            </Border>

            <!-- Левая панель навигации для АДМИНА -->
            <Border Grid.Column="0" Grid.Row="0" Background="#2C3E50"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="AEGIS" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,50"/>



                    <Button Content="Парковки" 
                            Height="50"
                            Margin="10,5"
                            Background="#34495E"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding NavigateToAdminDashboardCommand}"/>

                    <Button Content="Сотрудники" 
                            Height="50"
                            Margin="10,5"
                            Background="#34495E"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding NavigateToEmployeesCommand}"/>

                    <Button Content="Редактор парковок" 
                            Height="50"
                            Margin="10,5"
                            Background="#34495E"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding NavigateToParkingEditorCommand}"/>

                    <Button Content="Аналитика" 
                            Height="50"
                            Margin="10,5"
                            Background="#34495E"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding NavigateToAnalyticsCommand}"/>

                    <Button Content="История авто" 
                            Height="50"
                            Margin="10,5"
                            Background="#34495E"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding NavigateToAdminHistoryCommand}"/>

                    <Button Content="История платежей" 
                            Height="50"
                            Margin="10,5"
                            Background="#34495E"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding NavigateToPaymentsHistoryCommand}"/>
                </StackPanel>
            </Border>

            <!-- Основной контент -->
            <Border Grid.Column="1" Grid.Row="0" Background="#ECF0F1">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>

            <!-- Нижняя панель с информацией о пользователе -->
            <Border Grid.Column="0" Grid.Row="1" Background="#1A252F">
    <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ФИО и роль -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentUserName}" 
                       Foreground="White" 
                       FontSize="14"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding CurrentUserRole}" 
                       Foreground="#95A5A6" 
                       FontSize="12"/>
        </StackPanel>

        <!-- Кнопка настроек -->
        <Button Grid.Column="1"
                Content="⚙"
                Width="40" Height="40"
                Background="Transparent"
                Foreground="White"
                FontSize="20"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Настройки аккаунта"
                Command="{Binding OpenSettingsCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" 
                                        Background="Transparent" 
                                        CornerRadius="5"
                                        Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#34495E"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#2C3E50"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Border>
            <!-- Кнопка выхода -->
            <Border Grid.Column="1" Grid.Row="1" Background="#1A252F">
                <Button Content="Выйти" 
                        HorizontalAlignment="Right"
                        Margin="0,0,20,0"
                        Width="100"
                        Height="35"
                        Background="#E74C3C"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding LogoutCommand}"/>
            </Border>
        </Grid>

        <!-- Экран входа (показывается до авторизации) -->
        <ContentControl Content="{Binding CurrentViewModel}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVisibilityConverter}}" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
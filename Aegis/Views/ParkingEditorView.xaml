<UserControl x:Class="Aegis.Views.ParkingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка создания -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Редактор парковок" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="➕ Добавить парковку"
                    Width="200" Height="40"
                    Background="#27AE60" Foreground="White"
                    FontSize="16" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Command="{Binding CreateParkingCommand}"/>
        </Grid>

        <!-- Контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Список парковок -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Parkings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1" 
                                    CornerRadius="5" Margin="0,0,0,10" Padding="15" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8F9F9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding Address}" FontSize="16" FontWeight="Bold"/>

                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.ShowDetailsCommand, 
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Детали -->
            <Border Grid.Column="1" Width="500" Background="#F8F9F9" BorderBrush="#8E44AD" BorderThickness="2"
                    CornerRadius="10" Padding="25"
                    Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Детали парковки" FontSize="20" FontWeight="Bold"/>
                            <Button Grid.Column="1" Content="✕"
                                    Width="35" Height="35"
                                    Background="#E74C3C" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.HideDetailsCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Grid>

                        <TextBlock Text="{Binding SelectedDetails.Address}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                        <!-- Тарифы -->
                        <TextBlock Text="Тарифы:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding SelectedDetails.Tariffs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" Padding="10" Margin="0,0,0,5" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding VehicleType}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0} ₽/час}" Foreground="#27AE60"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Места -->
                        <TextBlock Text="Места:" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                        <ItemsControl ItemsSource="{Binding SelectedDetails.Spots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" Padding="10" Margin="0,0,0,5" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" FontWeight="Bold" Width="50"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VehicleType}" Margin="10,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Кнопки управления -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="✏️ Редактировать"
                                    Width="150" Height="40" Margin="0,0,10,0"
                                    Background="#3498DB" Foreground="White"
                                    FontSize="14" FontWeight="Bold"
                                    BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.EditParkingCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                            <Button Content="🗑️ Удалить"
                                    Width="120" Height="40"
                                    Background="#E74C3C" Foreground="White"
                                    FontSize="14" FontWeight="Bold"
                                    BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.DeleteParkingCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    IsEnabled="{Binding DataContext.CanDelete, 
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
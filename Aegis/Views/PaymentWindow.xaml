<Window x:Class="Aegis.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата" 
        Height="692" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#ECF0F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock Text="ОПЛАТА УСЛУГ ПАРКОВКИ" 
                       FontSize="22" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Детали оплаты -->
        <Border Grid.Row="1" Background="White" Margin="30" Padding="25" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Гос. номер:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtLicensePlate" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Номер чека:" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <TextBlock x:Name="TxtReceiptNumber" FontSize="14" FontWeight="Bold" Foreground="#3498DB" Margin="0,0,0,15"/>

                <Separator Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Плата за стоянку:" FontSize="16"/>
                    <TextBlock x:Name="TxtStorageFee" Grid.Column="1" FontSize="16" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Штраф за эвакуацию:" FontSize="16"/>
                    <TextBlock x:Name="TxtTowFine" Grid.Column="1" FontSize="16" FontWeight="Bold"/>
                </Grid>

                <Separator Margin="0,15,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="К ОПЛАТЕ:" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTotal" Grid.Column="1" FontSize="24" FontWeight="Bold" Foreground="#C0392B"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
            <Button Content="Отмена"
                    Width="150" Height="50" Margin="0,0,15,0"
                    Background="#95A5A6" Foreground="White"
                    FontSize="16" BorderThickness="0" Cursor="Hand"
                    Click="Cancel_Click"/>

            <Button Content="✅ Оплатить"
                    Width="200" Height="50"
                    Background="#27AE60" Foreground="White"
                    FontSize="18" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Click="Pay_Click"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="Aegis.Views.CreateParkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание парковки" 
        Height="700" Width="600"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock Text="Создание парковки" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Город *" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtCity" Height="35" Margin="0,0,0,15" Padding="8"/>

            <TextBlock Text="Улица *" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtStreet" Height="35" Margin="0,0,0,15" Padding="8"/>

            <TextBlock Text="Дом *" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtBuilding" Height="35" Margin="0,0,0,15" Padding="8"/>

            <TextBlock Text="Тарифы" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
            <ItemsControl x:Name="LstTariffs">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="14"/>
                            <TextBox Grid.Column="1" Tag="{Binding Id}" 
                                     Height="30" Padding="5"
                                     PreviewTextInput="NumberOnly"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Места" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSpotNumber" Height="30" Padding="5" Grid.Column="0"/>
                <ComboBox x:Name="CmbSpotType" Grid.Column="1" Height="30"/>
                <Button Grid.Column="2" Content="➕ Добавить место" Width="150" Height="30"
                        Background="#3498DB" Foreground="White" BorderThickness="0"
                        Click="AddSpot_Click"/>
            </Grid>

            <ListBox x:Name="LstSpots" Height="150" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Отмена" Width="120" Height="40" Margin="0,0,10,0"
                        Background="#95A5A6" Foreground="White"
                        Click="Cancel_Click"/>
                <Button Content="Создать" Width="150" Height="40"
                        Background="#27AE60" Foreground="White"
                        FontWeight="Bold"
                        Click="Create_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>